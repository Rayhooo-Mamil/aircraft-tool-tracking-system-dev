# Copy this file to .env. Do not commit .env.
# Use the same project URL and publishable/anon key already used by the React app.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Bluetooth Serial Port Profile (SPP) port shown by Windows after pairing.
BLUETOOTH_COM_PORT=COM11
BLUETOOTH_BAUD=115200

# Must match the values expected by the existing scan_events workflow.
SCANNER_DEVICE_ID=ESP32-PN532-01
SCAN_MODE=checkout

# Prevent the same NFC card resting on the reader from creating repeated events.
DEDUPE_SECONDS=2
